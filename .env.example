# ========================
# DATABASE CONFIGURATION
# ========================
POSTGRES_USER=khassistant
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=knowledge_assistant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ========================
# BACKEND CONFIGURATION
# ========================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development
SECRET_KEY=your_jwt_secret_key_here_min_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================
# FRONTEND CONFIGURATION
# ========================
VITE_API_URL=http://localhost:8000
VITE_AUTH_URL=http://localhost:8080

# ========================
# KEYCLOAK CONFIGURATION
# ========================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_password
KEYCLOAK_REALM=knowledge-assistant
KEYCLOAK_CLIENT_ID=knowledge-assistant-web
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here
KEYCLOAK_URL=http://localhost:8080

# ========================
# AI SERVICE CONFIGURATION
# ========================
AI_SERVICE_HOST=ai-service
AI_SERVICE_PORT=8001
OLLAMA_MODEL=llama2:7b
OLLAMA_HOST=http://ollama:11434

# ========================
# REDIS CONFIGURATION
# ========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ========================
# FILE STORAGE
# ========================
DOCUMENTS_DIR=/app/documents
MAX_FILE_SIZE=52428800  # 50MB

# ========================
# LOGGING
# ========================
LOG_LEVEL=INFO
